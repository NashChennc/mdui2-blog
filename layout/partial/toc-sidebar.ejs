<% if (tocHtml && String(tocHtml).trim()) { %>
<aside class="page-sidebar page-sidebar--post sticky-sidebar">
    <nav class="post-toc-panel toc-full-height" aria-label="<%= __('toc') %>">
        <div class="post-toc-inner">
            <div class="post-toc-scroll mdui-prose">
                <%- tocHtml %>
            </div>
        </div>
    </nav>
</aside>
<% } %>
