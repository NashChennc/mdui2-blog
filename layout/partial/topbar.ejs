<%
  var topbarTocHtml = partial('partial/toc');
  var hasTopbarTocDrawer = Boolean(topbarTocHtml && String(topbarTocHtml).trim());
  var hasTopbarCategories = site.categories.length;
  var hasTopbarDrawer = hasTopbarCategories || hasTopbarTocDrawer;
%>

<mdui-top-app-bar class="app-top-bar" scroll-behavior="elevate">
  <% if (hasTopbarDrawer) { %>
    <mdui-button-icon
      id="site-nav-toggle"
      class="topbar-mobile-control"
      variant="standard"
      icon="menu"
      aria-label="<%= hasTopbarTocDrawer ? __('toc') : __('categories') %>"
      aria-expanded="false"
      aria-haspopup="true"
      aria-controls="site-category-drawer"
    ></mdui-button-icon>
  <% } %>

  <mdui-button-icon
    variant="standard"
    icon="home"
    href="<%- url_for('/') %>"
    class="topbar-mobile-home-btn"
    aria-label="<%= __('home') %>"
    <% if (is_home()) { %>selected aria-current="page"<% } %>
  ></mdui-button-icon>

  <% if (hasTopbarCategories) { %>
  <div class="topbar-desktop-spacer" aria-hidden="true"></div>

  <nav class="topbar-desktop-nav" aria-label="<%= __('categories') %>">
    <a
      href="<%- url_for('/') %>"
      class="topbar-desktop-link topbar-desktop-home__link<%= is_home() ? ' topbar-desktop-link--active' : '' %>"
      <% if (is_home()) { %>aria-current="page"<% } %>
    ><%= __('home') %></a>
    <% site.categories.sort('length').sort('-name').each(function (item) { %>
      <% if (item.posts.length) { %>
    <a
      href="<%- url_for('categories/' + item.name) %>"
      class="topbar-desktop-link topbar-category-link<%= is_category() && page.category === item.name ? ' topbar-desktop-link--active' : '' %>"
      <% if (is_category() && page.category === item.name) { %>aria-current="page"<% } %>
    ><%= item.name %> · <%= item.posts.length %></a>
      <% } %>
    <% }); %>
  </nav>
  <% } %>

  <mdui-top-app-bar-title class="topbar-title<%= hasTopbarCategories ? ' topbar-title--mobile' : '' %>"><%= config.title %></mdui-top-app-bar-title>

  <div class="topbar-actions">
    <mdui-button-icon
      variant="standard"
      icon="calendar_month"
      href="<%- url_for('/archives') %>"
      class="topbar-archive-btn"
      aria-label="<%= __('archives') %>"
    ></mdui-button-icon>
    <mdui-button-icon
      id="site-search-toggle"
      variant="standard"
      icon="search"
      class="topbar-search-toggle"
      aria-label="<%= __('search') %>"
      aria-expanded="false"
      aria-haspopup="dialog"
      aria-controls="search-palette"
      aria-keyshortcuts="Control+K Meta+K"
    ></mdui-button-icon>
    <mdui-button-icon
      id="theme-toggle"
      variant="standard"
      icon="dark_mode"
      class="topbar-theme-toggle"
      data-label-dark="<%= __('theme_toggle_to_dark') %>"
      data-label-light="<%= __('theme_toggle_to_light') %>"
      data-label-follow="<%= __('theme_toggle_follow_system') %>"
      aria-label="<%= __('theme_toggle_to_dark') %>"
    ></mdui-button-icon>
    <%- partial('partial/topbar-profile') %>
  </div>
</mdui-top-app-bar>
