<%
  var drawerTocHtml = '';
  if (page.layout === 'post' && page.toc !== false && page.content) {
    drawerTocHtml = toc(page.content, { class: 'post-toc', list_number: false, max_depth: 3 });
  }
  var hasDrawerToc = drawerTocHtml && String(drawerTocHtml).trim();
  var hasDrawerCategories = site.categories.length;
%>

<% if (hasDrawerCategories || hasDrawerToc) { %>
<mdui-navigation-drawer
  id="site-category-drawer"
  class="site-category-drawer"
  modal
  close-on-esc
  close-on-overlay-click
  aria-label="<%= hasDrawerToc ? __('toc') : __('categories') %>"
>
  <% if (hasDrawerToc) { %>
  <nav class="site-category-drawer__section site-category-drawer__toc" aria-label="<%= __('toc') %>">
    <div class="post-toc-scroll mdui-prose">
      <%- drawerTocHtml %>
    </div>
  </nav>
  <% } %>

  <% if (hasDrawerToc && hasDrawerCategories) { %>
  <mdui-divider class="site-category-drawer__divider"></mdui-divider>
  <% } %>

  <% if (hasDrawerCategories) { %>
  <mdui-list class="site-category-drawer__list">
    <% site.categories.sort('length').sort('-name').each(function (item) { %>
      <% if (item.posts.length) { %>
    <mdui-list-item
      rounded
      icon="folder"
      href="<%- url_for('categories/' + item.name) %>"
      <% if (is_category() && page.category === item.name) { %>active<% } %>
    >
      <%= item.name %>
      <span slot="description"><%= item.posts.length %> <%= item.posts.length === 1 ? __('activity_heatmap_post') : __('activity_heatmap_posts') %></span>
    </mdui-list-item>
      <% } %>
    <% }); %>
  </mdui-list>
  <% } %>
</mdui-navigation-drawer>
<% } %>
