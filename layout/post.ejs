<!-- 全宽 Banner -->
<% if (theme.banner && theme.banner.post && theme.banner.post.enable) { %>
<%- partial('partial/banner') %>
<% } %>

<%
    var backlinks = post_backlinks(page);
    var backlinkTitle = __('post_backlinks_title');
    var postTocHtml = partial('partial/toc');
    var hasPostToc = Boolean(postTocHtml && String(postTocHtml).trim());
%>

<div class="page-shell app-container">
    <div class="page-grid page-grid--post<%= hasPostToc ? '' : ' page-grid--single' %>">
        <!-- 文章内容 -->

        <main class="page-main page-main--post">
            <mdui-card variant="filled" class="post-page-card">
                <div class="post-page-card__header">
                    <h1 class="post-page__title note-card-title"><%= page.blog_title || page.title %></h1>
                    <div class="post-page__meta-row">
                        <span class="note-date"><%= date(page.updated, 'YYYY MMM DD') %></span>
                        <% if (page.categories && page.categories.length) { %>
                            <div class="post-page__meta--cats">
                                <% page.categories.each(cat => { %>
                                    <a href="<%= url_for(cat.path) %>" class="note-tag"><%= cat.name %></a>
                                <% }) %>
                            </div>
                        <% } %>
                        <% if (page.tags && page.tags.length) { %>
                            <div class="post-page__meta--cats">
                                <% page.tags.each(tag => { %>
                                    <a href="<%= url_for(tag.path) %>" class="note-tag"><%= tag.name %></a>
                                <% }) %>
                            </div>
                        <% } %>
                        <span class="note-read"><%= min2read(page.content, { cn: 200, en: 500 }) %> <%= __('min_read') %></span>
                    </div>
                    <mdui-divider></mdui-divider>
                </div>
                <div class="post-page-card__body">
                    <div class="mdui-prose">
                        <%- page.content %>
                    </div>
                    <% if (backlinks.length) { %>
                    <section class="post-backlinks" aria-labelledby="post-backlinks-title">
                        <h2 id="post-backlinks-title" class="post-backlinks__title"><%= backlinkTitle %></h2>
                        <div class="post-backlinks__list">
                            <% backlinks.forEach(function (backlinkPost) { %>
                                <a class="post-backlinks__link" href="<%- url_for(backlinkPost.path) %>"><%= backlinkPost.blog_title || backlinkPost.title %></a>
                            <% }) %>
                        </div>
                    </section>
                    <% } %>
                </div>
                <%- partial('partial/link') %>
            </mdui-card>
        </main>
        <%- partial('partial/toc-sidebar', { tocHtml: postTocHtml }) %>
    </div>
</div>
<div id="page-bottom" aria-hidden="true"></div>
